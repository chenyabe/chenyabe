Tab:AddButton({
	Name = "无冷却+全图范围",
	Callback = function()
      	local running = true
        local Players = game:GetService("Players")
        local Player = Players.LocalPlayer

        -- 创建一个函数来处理武器修改
        local function modifyWeaponAnimations(tool)
            -- 检查工具是否有动画文件夹
            if not tool:FindFirstChild("Animations") then
                return
            end

            local animations = tool.Animations
            -- 检查是否有攻击动画文件夹
            if not animations:FindFirstChild("AttackAnimations") then
                return
            end

            local attackAnimations = animations.AttackAnimations
            -- 遍历所有攻击动画
            for _, animation in ipairs(attackAnimations:GetChildren()) do
                -- 安全地设置属性，避免错误
                pcall(function()
                    if animation:IsA("Animation") then
                        -- 这些属性可能不存在于Animation对象中，所以需要检查
                        if animation:FindFirstChild("EndDelay") then
                            animation.EndDelay.Value = 0
                        end

                        if animation:FindFirstChild("StartDelay") then
                            animation.StartDelay.Value = 0
                        end

                        if animation:FindFirstChild("HitboxSize") then
                            animation.HitboxSize.Value = Vector3.new(500000, 500000, 500000)
                        end

                        if animation:FindFirstChild("HitboxOffset") then
                            animation.HitboxOffset.Value = Vector3.new(0, 0, 0)
                        end
                    end
                end)
            end
        end

        -- 监听背包变化
        Player.Backpack.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                -- 给工具一点时间加载完整
                wait(0.5)
                modifyWeaponAnimations(child)
            end
        end)

        -- 初始处理已存在的工具
        for _, tool in ipairs(Player.Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                modifyWeaponAnimations(tool)
            end
        end
  	end
})

